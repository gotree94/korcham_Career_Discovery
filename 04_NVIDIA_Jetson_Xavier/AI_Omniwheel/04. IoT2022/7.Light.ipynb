   "source": [
    "import busio\n",
    "import board\n",
    "import adafruit_bh1750\n",
    "import time\n",
    "i2c = busio.I2C(board.SCL_1, board.SDA_1, frequency = 100000)\n",
    "light_sensor - adafruit_bh1750.BH1750(i2c)\n",
    "while True:\n",
    "    val = light_sensor.lux\n",
    "    print(\"조도 감지 센서 : %2f Lux\"%val)\n",
    "    time.sleep(1)"
   ]
  }
